# ─── Registry — environment configuration ───────────────────────────────────
# Copy to `.env.local` and fill in. The app runs with NONE of these set:
# it falls back to an in-memory seeded store and a deterministic mock LLM so
# every flow is demonstrable locally without external services.

# ── LLM (contract clause extraction only — NEVER used for risk tiering) ──
# When unset, contract extraction uses a deterministic offline mock.
ANTHROPIC_API_KEY=
# Model used for extraction. Store this with every extraction row for audit.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Persistence ──
# "memory" (default, seeded, ephemeral) or "postgres".
DATA_STORE=memory
# Required only when DATA_STORE=postgres. Point at Supabase/Postgres.
DATABASE_URL=

# ── Auth ──
# "local" (default; email + role picker for demo) or "workos".
AUTH_MODE=local
# Required only when AUTH_MODE=workos (Entra ID / Google SSO for B2B buyers).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Object storage (contract originals) ──
# "local" (default; ./.data/uploads) or "supabase".
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=contracts
